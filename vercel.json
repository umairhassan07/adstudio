{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/generate", "destination": "/api/generate" },
    { "source": "/api/poll", "destination": "/api/poll" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
